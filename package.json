{
  "name": "nsqjs-extra",
  "version": "0.1.0",
  "description": "Extra NodeJS client for the nsq client protocol.",
  "main": "index.js",
  "engines": {
    "node": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint . && npm run lint:lockfile",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config .prettierrc.js --write '**/*.js'",
    "test": "node scripts/run-tests.js --detectOpenHandles",
    "test:watch": "node scripts/run-tests.js --watch",
    "coverage:view": "open-cli coverage/lcov-report/index.html",
    "semantic-release": "semantic-release",
    "lint:lockfile": "lockfile-lint --path package-lock.json --validate-https --allowed-hosts npm yarn"
  },
  "author": {
    "name": "Hoang Dinh",
    "email": "hoang.dinh21@gmail.com",
    "url": "https://github.com/dv-hoang"
  },
  "license": "MIT",
  "keywords": [
    "nsqjs,client,promise,async"
  ],
  "homepage": "https://github.com/dv-hoang/nsqjs-extra",
  "bugs": {
    "url": "https://github.com/dv-hoang/nsqjs-extra/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dv-hoang/nsqjs-extra.git"
  },
  "dependencies": {
    "nsqjs": "^0.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^7.1.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "cz-conventional-changelog": "^1.2.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^3.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^9.2.0",
    "lockfile-lint": "^5.1.0",
    "open-cli": "^9.0.0",
    "prettier": "^1.18.2",
    "semantic-release": "^25.0.9",
    "sinon": "^9.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testPathIgnorePatterns": [
      "/__tests__/.*/__fixtures__/.*"
    ],
    "collectCoverageFrom": [
      "index.js",
      "src/**/*.{js,ts}"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint --env HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged",
      "post-merge": "npm install",
      "pre-push": "npm run lint && npm run test"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "npm run format",
      "git add"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": [
      "**/out/"
    ]
  },
  "eslintIgnore": [
    "coverage/**"
  ],
  "eslintConfig": {
    "env": {
      "node": true,
      "es6": true,
      "jest": true
    },
    "plugins": [
      "import",
      "n",
      "security",
      "jest"
    ],
    "extends": [
      "standard",
      "plugin:n/recommended"
    ],
    "rules": {
      "no-process-exit": "warn",
      "jest/no-disabled-tests": "error",
      "jest/no-focused-tests": "error",
      "jest/no-identical-title": "error",
      "n/no-unsupported-features/es-syntax": "off",
      "n/no-unsupported-features/es-builtins": "off",
      "n/no-unpublished-require": "off",
      "security/detect-non-literal-fs-filename": "error",
      "security/detect-unsafe-regex": "error",
      "security/detect-buffer-noassert": "error",
      "security/detect-child-process": "error",
      "security/detect-disable-mustache-escape": "error",
      "security/detect-eval-with-expression": "error",
      "security/detect-no-csrf-before-method-override": "error",
      "security/detect-non-literal-regexp": "error",
      "security/detect-object-injection": "warn",
      "security/detect-possible-timing-attacks": "error",
      "security/detect-pseudoRandomBytes": "error",
      "space-before-function-paren": "off",
      "object-curly-spacing": "off"
    },
    "parserOptions": {
      "ecmaVersion": 2018,
      "ecmaFeatures": {
        "impliedStrict": true
      }
    }
  },
  "release": {
    "branch": "master",
    "analyzeCommits": {
      "preset": "angular",
      "releaseRules": [
        {
          "type": "docs",
          "release": "patch"
        },
        {
          "type": "refactor",
          "release": "patch"
        },
        {
          "type": "style",
          "release": "patch"
        }
      ]
    }
  },
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md"
        ]
      }
    ],
    "@semantic-release/github"
  ]
}
